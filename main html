        // --- 7. Filtering & Navigation Controllers ---
        function switchView(viewName) {
            activeView = viewName;
            const dirView = document.getElementById('view-directory');
            const callsView = document.getElementById('view-calls');
            const navDir = document.getElementById('nav-directory');
            const navCalls = document.getElementById('nav-calls');

            if (viewName === 'directory') {
                dirView.classList.remove('hidden');
                callsView.classList.add('hidden');
                navDir.className = 'px-4 py-1.5 rounded-full text-xs sm:text-sm font-medium transition-all bg-ink text-canvas shadow-sm';
                navCalls.className = 'px-4 py-1.5 rounded-full text-xs sm:text-sm font-medium text-muted hover:text-ink transition-all';
            } else {
                dirView.classList.add('hidden');
                callsView.classList.remove('hidden');
                navCalls.className = 'px-4 py-1.5 rounded-full text-xs sm:text-sm font-medium transition-all bg-ink text-canvas shadow-sm';
                navDir.className = 'px-4 py-1.5 rounded-full text-xs sm:text-sm font-medium text-muted hover:text-ink transition-all';
            }
        }

        function setDisciplineFilter(disc) {
            activeDiscipline = disc;
            document.querySelectorAll('.disc-btn').forEach(btn => {
                if (btn.dataset.disc === disc) {
                    btn.className = 'disc-btn px-3.5 py-1.5 rounded-full text-xs font-medium bg-ink text-canvas transition shrink-0';
                } else {
                    btn.className = 'disc-btn px-3.5 py-1.5 rounded-full text-xs font-medium bg-paper text-ink hover:bg-hairline/60 transition shrink-0';
                }
            });
            renderArtists();
        }

        function filterArtists() {
            renderArtists();
        }

        function resetFilters() {
            document.getElementById('search-input').value = '';
            document.getElementById('availability-filter').value = 'all';
            document.getElementById('location-filter').value = 'all';
            setDisciplineFilter('All');
        }

        function filterCalls(category) {
            activeCallCategory = category;
            document.querySelectorAll('.call-cat-btn').forEach(btn => {
                if (btn.dataset.callCat === category) {
                    btn.className = 'call-cat-btn px-3.5 py-1.5 rounded-full text-xs font-medium bg-ink text-canvas transition shrink-0';
                } else {
                    btn.className = 'call-cat-btn px-3.5 py-1.5 rounded-full text-xs font-medium bg-paper text-ink hover:bg-hairline/60 transition shrink-0';
                }
            });
            renderOpenCalls();
        }

        // --- 8. Modal Controllers (Create Profile, Open Call, Portfolio Preview) ---
        function openProfileModal() {
            const modal = document.getElementById('profile-modal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeProfileModal() {
            const modal = document.getElementById('profile-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function handleCreateProfile(e) {
            e.preventDefault();
            const name = document.getElementById('prof-name').value.trim();
            const location = document.getElementById('prof-location').value.trim();
            const discipline = document.getElementById('prof-discipline').value;
            const availability = document.getElementById('prof-availability').value;
            const tagsRaw = document.getElementById('prof-tags').value;
            const bio = document.getElementById('prof-bio').value.trim();
            const workTitle = document.getElementById('prof-work-title').value.trim();
            const motif = document.getElementById('prof-motif').value;

            const tags = tagsRaw.split(',').map(t => t.trim()).filter(Boolean);
            const newArtist = {
                id: 'art-' + Date.now(),
                name,
                location,
                cityTag: location.split(',')[0].trim(),
                discipline,
                availability,
                tags: tags.length ? tags : ['Mixed Media'],
                bio,
                workTitle,
                motif,
                accent: '#C85A32'
            };

            artists.unshift(newArtist);
            document.getElementById('create-profile-form').reset();
            closeProfileModal();
            switchView('directory');
            resetFilters();
            showToast(`Profile for ${name} published to the Atelier Index.`);
        }

        function openCallModal() {
            const modal = document.getElementById('call-modal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeCallModal() {
            const modal = document.getElementById('call-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function handleCreateCall(e) {
            e.preventDefault();
            const title = document.getElementById('call-title').value.trim();
            const author = document.getElementById('call-author').value.trim();
            const category = document.getElementById('call-category').value;
            const location = document.getElementById('call-location').value.trim();
            const timeline = document.getElementById('call-timeline').value.trim();
            const description = document.getElementById('call-desc').value.trim();

            const newCall = {
                id: 'call-' + Date.now(),
                title,
                author,
                authorId: 'custom-' + Date.now(),
                category,
                location,
                timeline,
                description,
                responses: 1,
                postedAt: 'Just now'
            };

            openCalls.unshift(newCall);
            document.getElementById('create-call-form').reset();
            closeCallModal();
            renderOpenCalls();
            showToast('Your open call has been posted to the board.');
        }

        function openPortfolioModal(artistId) {
            const artist = artists.find(a => a.id === artistId);
            if (!artist) return;

            document.getElementById('port-artist-disc').textContent = `${artist.discipline} Practice`;
            document.getElementById('port-artist-name').textContent = artist.name;
            document.getElementById('port-artwork-container').innerHTML = getPortfolioArtworkSVG(artist.motif, artist.accent);
            document.getElementById('port-work-title').textContent = artist.workTitle;
            document.getElementById('port-artist-loc').textContent = artist.location;
            document.getElementById('port-artist-avail').textContent = artist.availability;
            document.getElementById('port-artist-bio').textContent = artist.bio;
            document.getElementById('port-artist-tags').innerHTML = artist.tags.map(t =>
                `<span class="text-xs px-3 py-1 rounded-full bg-paper border border-hairline text-ink">${t}</span>`
            ).join('');

            const connectBtn = document.getElementById('port-connect-btn');
            connectBtn.onclick = () => {
                closePortfolioModal();
                openConnectDrawer(artist.id);
            };

            const modal = document.getElementById('portfolio-modal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closePortfolioModal() {
            const modal = document.getElementById('portfolio-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        // --- 9. Direct Messaging Drawer Logic ---
        function openConnectDrawer(artistId, prefillSubject = '') {
            const artist = artists.find(a => a.id === artistId);
            activeRecipientId = artistId;

            if (artist) {
                document.getElementById('drawer-recipient-name').textContent = artist.name;
                document.getElementById('drawer-recipient-meta').textContent = `${artist.location} • ${artist.availability}`;
            } else {
                document.getElementById('drawer-recipient-name').textContent = 'Project Lead';
                document.getElementById('drawer-recipient-meta').textContent = 'Open Call Correspondence';
            }

            if (prefillSubject) {
                document.getElementById('msg-body').value = prefillSubject;
            }

            renderConversation(artistId);

            document.getElementById('connect-drawer-backdrop').classList.remove('hidden');
            document.getElementById('connect-drawer').classList.remove('translate-x-full');
        }

        function openMessagesInbox() {
            // Open with the first active artist conversation
            const firstId = Object.keys(conversations)[0] || artists[0].id;
            openConnectDrawer(firstId);
        }

        function closeConnectDrawer() {
            document.getElementById('connect-drawer-backdrop').classList.add('hidden');
            document.getElementById('connect-drawer').classList.add('translate-x-full');
        }

        function insertPrompt(text) {
            const textarea = document.getElementById('msg-body');
            textarea.value = text;
            textarea.focus();
        }

        function renderConversation(recipientId) {
            const container = document.getElementById('drawer-messages');
            const thread = conversations[recipientId] || [];

            if (thread.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-10 px-4 border border-dashed border-hairline rounded-2xl bg-white/60">
                        <p class="font-serif text-xl text-ink mb-1">Start a Studio Dialogue</p>
                        <p class="text-xs text-muted leading-relaxed">Introduce your practice, share a link to your work, or propose a specific timeframe to connect.</p>
                    </div>
                `;
                return;
            }

            container.innerHTML = thread.map(msg => {
                const isSelf = msg.role === 'self';
                return `
                    <div class="flex flex-col ${isSelf ? 'items-end' : 'items-start'}">
                        <div class="flex items-center gap-2 mb-1">
                            <span class="font-mono text-[10px] text-muted">${msg.sender} • ${msg.time}</span>
                            <span class="text-[10px] px-2 py-0.5 rounded-full bg-paper border border-hairline text-ink">${msg.intent}</span>
                        </div>
                        <div class="max-w-[85%] rounded-2xl px-4 py-3 text-sm leading-relaxed ${isSelf ? 'bg-ink text-canvas rounded-br-xs' : 'bg-white border border-hairline text-ink rounded-bl-xs'}">
                            ${msg.text}
                        </div>
                    </div>
                `;
            }).join('');

            container.scrollTop = container.scrollHeight;
        }

        function handleSendMessage(e) {
            e.preventDefault();
            if (!activeRecipientId) return;

            const senderName = document.getElementById('msg-sender-name').value.trim() || 'Guest Practitioner';
            const intent = document.getElementById('msg-intent').value;
            const body = document.getElementById('msg-body').value.trim();
            if (!body) return;

            if (!conversations[activeRecipientId]) {
                conversations[activeRecipientId] = [];
            }

            const now = new Date();
            const timeStr = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

            conversations[activeRecipientId].push({
                sender: senderName,
                role: 'self',
                intent,
                text: body,
                time: timeStr
            });

            document.getElementById('msg-body').value = '';
            document.getElementById('unread-dot').classList.remove('hidden');
            renderConversation(activeRecipientId);
            showToast('Direct studio message dispatched.');
        }

        function respondToCall(callId) {
            const call = openCalls.find(c => c.id === callId);
            if (!call) return;

            call.responses += 1;
            renderOpenCalls();

            const targetArtist = artists.find(a => a.name === call.author);
            const targetId = targetArtist ? targetArtist.id : call.authorId;
            if (!targetArtist) {
                // Ensure conversation metadata works for custom call authors
                conversations[targetId] = conversations[targetId] || [];
            }

            openConnectDrawer(targetId, `Re: "${call.title}" — I'd love to discuss contributing to this project.`);
            if (!targetArtist) {
                document.getElementById('drawer-recipient-name').textContent = call.author;
                document.getElementById('drawer-recipient-meta').textContent = `${call.location} • ${call.category}`;
            }
        }

        // --- 10. Non-Intrusive Toast Notification System ---
        function showToast(message) {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = 'pointer-events-auto bg-ink text-canvas px-4 py-3 rounded-xl shadow-lg border border-neutral-700 text-xs font-medium flex items-center gap-2.5 transition-all duration-300';
            toast.innerHTML = `
                <span class="w-2 h-2 rounded-full bg-terracotta shrink-0"></span>
                <span>${message}</span>
            `;
            container.appendChild(toast);

            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateY(8px)';
                setTimeout(() => toast.remove(), 300);
            }, 3400);
        }

        // --- 11. Initialize Application on Load ---
        window.addEventListener('DOMContentLoaded', () => {
            renderArtists();
            renderOpenCalls();
        });
    </script>
</body>
</html>
