<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ATELIER — Contemporary Artist Network & Open Calls</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Editorial Serif (Cormorant Garamond / Instrument Serif) & Clean Sans (Inter / Space Mono) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Inter:wght@300;400;500;600&family=Space+Mono:ital,wght@0,400;1,400&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        serif: ['"Cormorant Garamond"', 'Georgia', 'serif'],
                        sans: ['"Inter"', '-apple-system', 'BlinkMacSystemFont', 'sans-serif'],
                        mono: ['"Space Mono"', 'monospace'],
                    },
                    colors: {
                        canvas: '#FAF9F6',
                        paper: '#F3F1EC',
                        ink: '#181816',
                        muted: '#6E6D68',
                        hairline: '#E2E0D8',
                        terracotta: '#C85A32',
                        sage: '#4A6B5D',
                        cobalt: '#2B4C7E'
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-canvas text-ink font-sans antialiased selection:bg-ink selection:text-canvas overflow-x-hidden">

    <!-- Toast Notification Banner (Replaces alert) -->
    <div id="toast-container" class="fixed bottom-6 right-6 z-50 flex flex-col gap-2 pointer-events-none"></div>

    <!-- Top Editorial Navigation Bar -->
    <header class="sticky top-0 z-30 bg-canvas/90 backdrop-blur-md border-b border-hairline">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between py-4 gap-4">
                <!-- Brand Identity -->
                <div class="flex items-center justify-between">
                    <a href="#" onclick="switchView('directory'); return false;" class="flex items-baseline gap-3 group">
                        <span class="font-serif text-3xl sm:text-4xl font-medium tracking-tight text-ink">ATELIER</span>
                        <span class="font-mono text-[11px] uppercase tracking-widest text-muted border border-hairline px-2 py-0.5 rounded-full bg-paper">Index 04</span>
                    </a>
                    <!-- Mobile Quick Action -->
                    <button onclick="openProfileModal()" class="sm:hidden bg-ink text-canvas text-xs font-medium px-3.5 py-2 rounded-full hover:bg-neutral-800 transition">
                        + Join Index
                    </button>
                </div>

                <!-- Primary View Switcher -->
                <nav class="flex items-center gap-1 bg-paper p-1 rounded-full border border-hairline self-start sm:self-auto" aria-label="Primary Views">
                    <button id="nav-directory" onclick="switchView('directory')" class="px-4 py-1.5 rounded-full text-xs sm:text-sm font-medium transition-all bg-ink text-canvas shadow-sm">
                        Artist Directory <span id="artist-count-badge" class="ml-1 font-mono text-[11px] opacity-80">(8)</span>
                    </button>
                    <button id="nav-calls" onclick="switchView('calls')" class="px-4 py-1.5 rounded-full text-xs sm:text-sm font-medium text-muted hover:text-ink transition-all">
                        Open Calls & Collabs <span id="calls-count-badge" class="ml-1 font-mono text-[11px] opacity-80">(5)</span>
                    </button>
                </nav>

                <!-- Desktop CTA Actions -->
                <div class="hidden sm:flex items-center gap-3">
                    <button onclick="openMessagesInbox()" class="relative p-2.5 rounded-full border border-hairline bg-white hover:bg-paper transition text-ink" title="Studio Inbox">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/>
                        </svg>
                        <span id="unread-dot" class="hidden absolute top-1.5 right-1.5 w-2 h-2 rounded-full bg-terracotta"></span>
                    </button>
                    <button onclick="openProfileModal()" class="bg-ink text-canvas text-xs sm:text-sm font-medium px-4 py-2.5 rounded-full hover:bg-neutral-800 transition flex items-center gap-2 shadow-sm">
                        <span>+ Share Artist Profile</span>
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- Editorial Hero / Curatorial Statement -->
    <section class="border-b border-hairline bg-paper/50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-end">
                <div class="lg:col-span-8">
                    <p class="font-mono text-xs uppercase tracking-widest text-terracotta mb-2">Peer-to-Peer Studio Exchange — Autumn/Winter</p>
                    <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-normal leading-[1.08] tracking-tight text-ink">
                        A living registry for <span class="italic font-normal">cross-disciplinary</span> dialogue, studio critiques & joint commissions.
                    </h1>
                </div>
                <div class="lg:col-span-4 flex flex-col justify-between lg:pl-6 lg:border-l border-hairline">
                    <p class="text-sm text-muted leading-relaxed mb-4">
                        Connect directly with sculptural fabricators, generative coders, spatial sound designers, and printmakers across Berlin, Tokyo, London, and beyond.
                    </p>
                    <div class="flex flex-wrap items-center gap-4 text-xs font-mono text-ink">
                        <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-sage"></span> Open for Collab</span>
                        <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-cobalt"></span> Studio Critique</span>
                        <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-terracotta"></span> Residency Swap</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- MAIN CONTENT CONTAINER -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">

        <!-- ========================================================= -->
        <!-- VIEW 1: FILTERABLE ARTIST DIRECTORY                       -->
        <!-- ========================================================= -->
        <div id="view-directory" class="space-y-8">
            
            <!-- Filter & Search Control Bar -->
            <div class="bg-white border border-hairline rounded-2xl p-4 sm:p-5 shadow-xs space-y-4">
                <div class="flex flex-col md:flex-row gap-4 justify-between">
                    <!-- Search Input -->
                    <div class="relative flex-1">
                        <svg class="w-4 h-4 text-muted absolute left-3.5 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"/>
                        </svg>
                        <input id="search-input" type="text" oninput="filterArtists()" placeholder="Search by artist name, medium (e.g., ceramic, TouchDesigner, 16mm), or city..." class="w-full pl-10 pr-4 py-2.5 bg-canvas border border-hairline rounded-xl text-sm text-ink placeholder:text-muted focus:outline-none focus:border-ink transition">
                    </div>

                    <!-- Availability Filter Dropdown -->
                    <div class="flex flex-wrap sm:flex-nowrap gap-3">
                        <select id="availability-filter" onchange="filterArtists()" class="w-full sm:w-auto bg-canvas border border-hairline rounded-xl px-3.5 py-2.5 text-sm text-ink focus:outline-none focus:border-ink cursor-pointer">
                            <option value="all">All Availability Statuses</option>
                            <option value="Open for Collaboration">Open for Collaboration</option>
                            <option value="Seeking Studio Critique">Seeking Studio Critique</option>
                            <option value="Open to Residency Swap">Open to Residency Swap</option>
                            <option value="Commission Available">Commission Available</option>
                        </select>

                        <select id="location-filter" onchange="filterArtists()" class="w-full sm:w-auto bg-canvas border border-hairline rounded-xl px-3.5 py-2.5 text-sm text-ink focus:outline-none focus:border-ink cursor-pointer">
                            <option value="all">All Cities</option>
                            <option value="Berlin">Berlin</option>
                            <option value="Tokyo">Tokyo</option>
                            <option value="London">London</option>
                            <option value="Mexico City">Mexico City</option>
                            <option value="New York">New York</option>
                            <option value="Seoul">Seoul</option>
                        </select>
                    </div>
                </div>

                <!-- Discipline Pill Filters -->
                <div class="flex items-center gap-2 overflow-x-auto pb-1 pt-1 border-t border-hairline/70" id="discipline-pills">
                    <span class="font-mono text-[11px] uppercase tracking-wider text-muted mr-1 shrink-0">Discipline:</span>
                    <button onclick="setDisciplineFilter('All')" data-disc="All" class="disc-btn px-3.5 py-1.5 rounded-full text-xs font-medium bg-ink text-canvas transition shrink-0">All Practices</button>
                    <button onclick="setDisciplineFilter('Visual')" data-disc="Visual" class="disc-btn px-3.5 py-1.5 rounded-full text-xs font-medium bg-paper text-ink hover:bg-hairline/60 transition shrink-0">Visual & Painting</button>
                    <button onclick="setDisciplineFilter('Digital')" data-disc="Digital" class="disc-btn px-3.5 py-1.5 rounded-full text-xs font-medium bg-paper text-ink hover:bg-hairline/60 transition shrink-0">Digital & Generative</button>
                    <button onclick="setDisciplineFilter('Spatial')" data-disc="Spatial" class="disc-btn px-3.5 py-1.5 rounded-full text-xs font-medium bg-paper text-ink hover:bg-hairline/60 transition shrink-0">Spatial & Sculpture</button>
                    <button onclick="setDisciplineFilter('Multimedia')" data-disc="Multimedia" class="disc-btn px-3.5 py-1.5 rounded-full text-xs font-medium bg-paper text-ink hover:bg-hairline/60 transition shrink-0">Multimedia & Sound</button>
                </div>
            </div>

            <!-- Active Filter Status & Reset -->
            <div class="flex items-center justify-between text-xs text-muted">
                <p id="results-summary">Showing all 8 resident artists</p>
                <button id="reset-filters-btn" onclick="resetFilters()" class="hidden text-terracotta hover:underline font-medium">Reset filters</button>
            </div>

            <!-- Artist Cards Grid -->
            <div id="artists-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
                <!-- Cards dynamically rendered via JS -->
            </div>

            <!-- Empty State -->
            <div id="empty-directory" class="hidden text-center py-16 bg-white border border-hairline rounded-2xl">
                <p class="font-serif text-2xl text-ink mb-2">No practitioners match those criteria.</p>
                <p class="text-sm text-muted mb-5">Try broadening your discipline or location filters, or add your own studio profile.</p>
                <button onclick="resetFilters()" class="px-4 py-2 rounded-full border border-ink text-xs font-medium hover:bg-ink hover:text-canvas transition">Clear All Filters</button>
            </div>
        </div>

        <!-- ========================================================= -->
        <!-- VIEW 2: OPEN CALLS & COLLABORATIONS BOARD                 -->
        <!-- ========================================================= -->
        <div id="view-calls" class="hidden space-y-8">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white border border-hairline rounded-2xl p-5 sm:p-6">
                <div>
                    <span class="font-mono text-[11px] uppercase tracking-widest text-terracotta">Bulletin & Project Proposals</span>
                    <h2 class="font-serif text-3xl text-ink mt-1">Open Calls & Studio Collaborations</h2>
                    <p class="text-sm text-muted mt-1">Propose a two-person exhibition, seek technical fabrication partners, or organize peer crits.</p>
                </div>
                <button onclick="openCallModal()" class="bg-terracotta text-white text-xs sm:text-sm font-medium px-5 py-3 rounded-full hover:opacity-90 transition shrink-0 self-start sm:self-auto shadow-xs">
                    + Post Open Call
                </button>
            </div>

            <!-- Call Category Filter Pills -->
            <div class="flex items-center gap-2 overflow-x-auto pb-1">
                <button onclick="filterCalls('All')" data-call-cat="All" class="call-cat-btn px-3.5 py-1.5 rounded-full text-xs font-medium bg-ink text-canvas transition shrink-0">All Calls</button>
                <button onclick="filterCalls('Co-Creation')" data-call-cat="Co-Creation" class="call-cat-btn px-3.5 py-1.5 rounded-full text-xs font-medium bg-paper text-ink hover:bg-hairline/60 transition shrink-0">Co-Creation</button>
                <button onclick="filterCalls('Exhibition / Space')" data-call-cat="Exhibition / Space" class="call-cat-btn px-3.5 py-1.5 rounded-full text-xs font-medium bg-paper text-ink hover:bg-hairline/60 transition shrink-0">Exhibition / Space</button>
                <button onclick="filterCalls('Technical Skill Swap')" data-call-cat="Technical Skill Swap" class="call-cat-btn px-3.5 py-1.5 rounded-full text-xs font-medium bg-paper text-ink hover:bg-hairline/60 transition shrink-0">Technical Skill Swap</button>
                <button onclick="filterCalls('Critique Circle')" data-call-cat="Critique Circle" class="call-cat-btn px-3.5 py-1.5 rounded-full text-xs font-medium bg-paper text-ink hover:bg-hairline/60 transition shrink-0">Critique Circle</button>
            </div>

            <!-- Open Calls Feed -->
            <div id="calls-list" class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <!-- Populated by JS -->
            </div>
        </div>

    </main>

    <!-- Editorial Footer -->
    <footer class="border-t border-hairline bg-paper mt-16">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 text-xs text-muted">
            <div>
                <span class="font-serif text-lg text-ink font-medium mr-2">ATELIER</span>
                <span>Independent Artist Index & Peer Exchange.</span>
            </div>
            <div class="font-mono text-[11px]">
                No algorithms. Direct studio-to-studio correspondence.
            </div>
        </div>
    </footer>

    <!-- ===================================================================== -->
    <!-- MODAL 1: CREATE / SHARE ARTIST PROFILE                                -->
    <!-- ===================================================================== -->
    <div id="profile-modal" class="fixed inset-0 z-40 hidden items-center justify-center p-4 bg-ink/50 backdrop-blur-xs overflow-y-auto">
        <div class="bg-canvas border border-hairline rounded-2xl max-w-2xl w-full p-6 sm:p-8 shadow-2xl my-8 relative">
            <div class="flex items-start justify-between border-b border-hairline pb-4 mb-6">
                <div>
                    <span class="font-mono text-[11px] uppercase tracking-widest text-terracotta">Directory Submission</span>
                    <h3 class="font-serif text-3xl text-ink mt-0.5">Share Your Artist Profile</h3>
                </div>
                <button onclick="closeProfileModal()" class="p-2 rounded-full hover:bg-paper text-muted hover:text-ink transition" aria-label="Close modal">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>

            <form id="create-profile-form" onsubmit="handleCreateProfile(event)" class="space-y-4">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-medium text-ink mb-1">Full Name / Studio Moniker *</label>
                        <input required type="text" id="prof-name" placeholder="e.g., Clara Lindqvist" class="w-full px-3.5 py-2.5 bg-white border border-hairline rounded-xl text-sm focus:outline-none focus:border-ink">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-ink mb-1">Current City & Country *</label>
                        <input required type="text" id="prof-location" placeholder="e.g., Berlin, Germany" class="w-full px-3.5 py-2.5 bg-white border border-hairline rounded-xl text-sm focus:outline-none focus:border-ink">
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-medium text-ink mb-1">Primary Discipline *</label>
                        <select id="prof-discipline" class="w-full px-3.5 py-2.5 bg-white border border-hairline rounded-xl text-sm focus:outline-none focus:border-ink">
                            <option value="Visual">Visual & Painting</option>
                            <option value="Digital">Digital & Generative</option>
                            <option value="Spatial">Spatial & Sculpture</option>
                            <option value="Multimedia">Multimedia & Sound</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-ink mb-1">Current Availability *</label>
                        <select id="prof-availability" class="w-full px-3.5 py-2.5 bg-white border border-hairline rounded-xl text-sm focus:outline-none focus:border-ink">
                            <option value="Open for Collaboration">Open for Collaboration</option>
                            <option value="Seeking Studio Critique">Seeking Studio Critique</option>
                            <option value="Open to Residency Swap">Open to Residency Swap</option>
                            <option value="Commission Available">Commission Available</option>
                        </select>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-medium text-ink mb-1">Mediums & Practice Tags (comma separated) *</label>
                    <input required type="text" id="prof-tags" placeholder="e.g., Raw Stoneware, Lime Plaster, Architectural Scale" class="w-full px-3.5 py-2.5 bg-white border border-hairline rounded-xl text-sm focus:outline-none focus:border-ink">
                </div>

                <div>
                    <label class="block text-xs font-medium text-ink mb-1">Artist Statement / Current Studio Focus *</label>
                    <textarea required id="prof-bio" rows="3" placeholder="Describe your current material inquiries and what kind of peers you hope to meet..." class="w-full px-3.5 py-2.5 bg-white border border-hairline rounded-xl text-sm focus:outline-none focus:border-ink"></textarea>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-medium text-ink mb-1">Featured Work Title *</label>
                        <input required type="text" id="prof-work-title" placeholder="e.g., Sediment Study No. 4 (2026)" class="w-full px-3.5 py-2.5 bg-white border border-hairline rounded-xl text-sm focus:outline-none focus:border-ink">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-ink mb-1">Portfolio Visual Motif</label>
                        <select id="prof-motif" class="w-full px-3.5 py-2.5 bg-white border border-hairline rounded-xl text-sm focus:outline-none focus:border-ink">
                            <option value="monolith">Sculptural Monolith & Shadow</option>
                            <option value="algorithmic">Generative Grid & Moiré</option>
                            <option value="pigment">Earth Pigment & Organic Form</option>
                            <option value="acoustic">Acoustic Waveform & Light</option>
                        </select>
                    </div>
                </div>

                <div class="pt-4 border-t border-hairline flex items-center justify-end gap-3">
                    <button type="button" onclick="closeProfileModal()" class="px-4 py-2.5 rounded-full text-xs font-medium text-muted hover:text-ink transition">Cancel</button>
                    <button type="submit" class="bg-ink text-canvas px-6 py-2.5 rounded-full text-xs font-medium hover:bg-neutral-800 transition">Publish to Index</button>
                </div>
            </form>
        </div>
    </div>

    <!-- ===================================================================== -->
    <!-- MODAL 2: POST NEW OPEN CALL / COLLABORATION                           -->
    <!-- ===================================================================== -->
    <div id="call-modal" class="fixed inset-0 z-40 hidden items-center justify-center p-4 bg-ink/50 backdrop-blur-xs overflow-y-auto">
        <div class="bg-canvas border border-hairline rounded-2xl max-w-xl w-full p-6 sm:p-8 shadow-2xl my-8 relative">
            <div class="flex items-start justify-between border-b border-hairline pb-4 mb-6">
                <div>
                    <span class="font-mono text-[11px] uppercase tracking-widest text-terracotta">Bulletin Board</span>
                    <h3 class="font-serif text-3xl text-ink mt-0.5">Post an Open Call</h3>
                </div>
                <button onclick="closeCallModal()" class="p-2 rounded-full hover:bg-paper text-muted hover:text-ink transition">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>

            <form id="create-call-form" onsubmit="handleCreateCall(event)" class="space-y-4">
                <div>
                    <label class="block text-xs font-medium text-ink mb-1">Project / Proposal Title *</label>
                    <input required type="text" id="call-title" placeholder="e.g., Seeking Spatial Sound Artist for Berlin Bunker Installation" class="w-full px-3.5 py-2.5 bg-white border border-hairline rounded-xl text-sm focus:outline-none focus:border-ink">
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-medium text-ink mb-1">Your Name / Studio *</label>
                        <input required type="text" id="call-author" placeholder="e.g., Lukas Weber" class="w-full px-3.5 py-2.5 bg-white border border-hairline rounded-xl text-sm focus:outline-none focus:border-ink">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-ink mb-1">Collaboration Type *</label>
                        <select id="call-category" class="w-full px-3.5 py-2.5 bg-white border border-hairline rounded-xl text-sm focus:outline-none focus:border-ink">
                            <option value="Co-Creation">Co-Creation</option>
                            <option value="Exhibition / Space">Exhibition / Space</option>
                            <option value="Technical Skill Swap">Technical Skill Swap</option>
                            <option value="Critique Circle">Critique Circle</option>
                        </select>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-medium text-ink mb-1">Location / Format *</label>
                        <input required type="text" id="call-location" placeholder="e.g., Berlin / Remote Hybrid" class="w-full px-3.5 py-2.5 bg-white border border-hairline rounded-xl text-sm focus:outline-none focus:border-ink">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-ink mb-1">Target Timeline *</label>
                        <input required type="text" id="call-timeline" placeholder="e.g., Jan – March 2027" class="w-full px-3.5 py-2.5 bg-white border border-hairline rounded-xl text-sm focus:outline-none focus:border-ink">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-medium text-ink mb-1">Proposal Details & What You Bring *</label>
                    <textarea required id="call-desc" rows="3" placeholder="Outline the concept, space, funding status, or specific skills you are looking to exchange..." class="w-full px-3.5 py-2.5 bg-white border border-hairline rounded-xl text-sm focus:outline-none focus:border-ink"></textarea>
                </div>

                <div class="pt-4 border-t border-hairline flex items-center justify-end gap-3">
                    <button type="button" onclick="closeCallModal()" class="px-4 py-2.5 rounded-full text-xs font-medium text-muted hover:text-ink transition">Cancel</button>
                    <button type="submit" class="bg-terracotta text-white px-6 py-2.5 rounded-full text-xs font-medium hover:opacity-90 transition">Publish Open Call</button>
                </div>
            </form>
        </div>
    </div>

    <!-- ===================================================================== -->
    <!-- MODAL 3: PORTFOLIO PREVIEW LIGHTBOX                                   -->
    <!-- ===================================================================== -->
    <div id="portfolio-modal" class="fixed inset-0 z-40 hidden items-center justify-center p-4 bg-ink/70 backdrop-blur-xs overflow-y-auto">
        <div class="bg-canvas border border-hairline rounded-2xl max-w-3xl w-full overflow-hidden shadow-2xl my-8">
            <div class="flex items-center justify-between px-6 py-4 border-b border-hairline bg-white">
                <div>
                    <span id="port-artist-disc" class="font-mono text-[11px] uppercase tracking-widest text-terracotta">Spatial & Sculpture</span>
